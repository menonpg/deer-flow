# DeerFlow Backend — Railway deployment
# Based on the official backend/Dockerfile with Railway-specific additions:
# - supervisord to run gateway (8001) + langgraph (2024) in one container
# - /data volume symlinks for persistent state

FROM python:3.12-slim

# ── System dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        supervisor \
        git \
    && rm -rf /var/lib/apt/lists/*

# ── uv ───────────────────────────────────────────────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# ── Source ────────────────────────────────────────────────────────────────────
COPY backend ./backend
COPY skills ./skills
COPY railway/config.railway.yaml ./config.yaml

# Create empty .env for langgraph.json reference (real secrets come from Railway env)
RUN touch ./backend/.env

# ── Install Python deps ───────────────────────────────────────────────────────
RUN cd backend && uv sync

# ── supervisord config ────────────────────────────────────────────────────────
COPY railway/supervisord.conf /etc/supervisor/conf.d/deerflow.conf

# ── Startup ───────────────────────────────────────────────────────────────────
COPY railway/start-backend.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 8001 2024

CMD ["/start.sh"]
