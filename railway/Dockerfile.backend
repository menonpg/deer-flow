# DeerFlow Backend — Railway deployment
# Runs both gateway (port 8001) and langgraph server (port 2024) in one container.
# A supervisord process manager keeps both alive and restarts on failure.

FROM python:3.12-slim

# ── System dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

# ── uv (fast Python package manager) ───────────────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# ── App source ──────────────────────────────────────────────────────────────
WORKDIR /app
COPY backend ./backend
COPY skills ./skills

# Use the Railway-specific config (MiniMax + Ollama pre-configured)
COPY railway/config.railway.yaml ./config.yaml

# ── Install Python dependencies ─────────────────────────────────────────────
RUN cd backend && uv sync --frozen

# ── supervisord config ──────────────────────────────────────────────────────
# Place in conf.d so supervisord picks it up automatically
COPY railway/supervisord.conf /etc/supervisor/conf.d/deerflow.conf

# ── Startup script ───────────────────────────────────────────────────────────
COPY railway/start-backend.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 8001 2024

CMD ["/start.sh"]
