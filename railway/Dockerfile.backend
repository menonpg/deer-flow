# DeerFlow Backend — Railway deployment
# Runs gateway (8001) + LangGraph (2024) in one container via supervisord.
# Skills are fetched from GitHub at startup (not COPY'd — excluded by .dockerignore).

FROM python:3.12-slim

# ── System dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        supervisor \
        git \
    && rm -rf /var/lib/apt/lists/*

# ── uv ───────────────────────────────────────────────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# ── Source (only backend — skills fetched at runtime) ────────────────────────
COPY backend ./backend

# Create empty .env so langgraph.json reference doesn't fail at build time
RUN touch ./backend/.env

# ── Install Python deps ───────────────────────────────────────────────────────
RUN cd backend && uv sync

# ── Data science packages (needed for EDA, visualisation, image tasks) ────────
RUN pip install --no-cache-dir \
    pandas \
    matplotlib \
    numpy \
    seaborn \
    scipy \
    scikit-learn \
    Pillow \
    plotly \
    openpyxl

# ── Railway config ────────────────────────────────────────────────────────────
COPY railway/config.railway.yaml ./config.yaml
COPY railway/supervisord.conf /etc/supervisor/conf.d/deerflow.conf
COPY railway/start-backend.sh /start.sh
RUN chmod +x /start.sh

# Create /mnt so skill symlink works at runtime
RUN mkdir -p /mnt /app/skills /mnt/user-data/workspace /mnt/user-data/outputs

EXPOSE 8001 2024

CMD ["/start.sh"]
